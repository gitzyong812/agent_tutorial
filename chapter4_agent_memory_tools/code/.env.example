# 复制本文件为 .env 后按需修改。请勿提交 .env 到代码仓库。

# 数据库地址，默认使用项目目录下的 SQLite 文件。
# 后续章节可改为服务器数据库，例如 postgresql+psycopg://user:pwd@host/db
APP_DATABASE_URL=sqlite:///./chatbot.db

# 每天按服务器本地时间自动整理核心记忆。
MEMORY_DREAM_ENABLED=true
MEMORY_DREAM_HOUR=2

# OpenAI-compatible embedding endpoint for RAG indexing and vector retrieval.
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL_NAME=text-embedding-v3
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1024

# RAG 文档默认分块大小，中文按字符计长。
DEFAULT_CHUNK_SIZE=400

# Embedding 接口单次批量文本数量。
DEFAULT_BATCH_SIZE=10
