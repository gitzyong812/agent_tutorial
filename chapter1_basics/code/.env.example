# Copy this file to .env, then keep only one provider configuration.
# Do not commit .env to Git.

# OpenAI
LLM_API_KEY=your_openai_api_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

