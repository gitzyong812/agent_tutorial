# 复制本文件为 .env 后按需修改。请勿提交 .env 到代码仓库。

# 应用与数据库
# 默认使用项目目录下的 SQLite 文件。
# 后续章节可改为服务器数据库，例如 postgresql+psycopg://user:pwd@host/db
APP_DATABASE_URL=sqlite:///./chatbot.db
SQLITE_TIMEOUT_SECONDS=30

# 记忆
# 每天按服务器本地时间自动整理核心记忆。
MEMORY_DREAM_ENABLED=true
MEMORY_DREAM_HOUR=2

# RAG 与向量化
# OpenAI-compatible embedding endpoint for RAG indexing and vector retrieval.
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL_NAME=text-embedding-v3
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1024
DEFAULT_CHUNK_SIZE=400
DEFAULT_CHUNK_OVERLAP=60
DEFAULT_BATCH_SIZE=10

# Agent 与人工协同
DEFAULT_AGENT_MAX_TOKENS=2048
DEFAULT_AGENT_MAX_STEPS=24
MAX_AGENT_MAX_STEPS=100
REACT_TEXT_DELTA_CHARS=32
MAX_HUMAN_REQUESTS_PER_RUN=2
MAX_HUMAN_QUESTION_CHARS=500
MAX_HANDOFF_FIELD_CHARS=1000

# 工具执行
HTTP_TOOL_TIMEOUT_SECONDS=10
MAX_HTTP_TOOL_RESPONSE_BYTES=16384

# 技能管理
MAX_SKILL_FILES=100
MAX_SKILL_BYTES=10485760

# 审计与监控
AUDIT_MAX_TEXT_CHARS=500
AUDIT_MAX_ITEMS=20
MONITORING_DEFAULT_LIMIT=20
MONITORING_MAX_LIMIT=100

# CLI 通道
CLI_REQUEST_TIMEOUT_SECONDS=120

# 微信通道
WEIXIN_BASE_URL=https://ilinkai.weixin.qq.com
WEIXIN_API_TIMEOUT_SECONDS=15
WEIXIN_LONG_POLL_SECONDS=35
WEIXIN_QR_POLL_SECONDS=10
